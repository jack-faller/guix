{
  "layer": "bottom",
  "height": 16,
  "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
  "modules-center": ["clock"],
  "modules-right": ["disk", "memory", "cpu", "temperature", "network", "custom/webcam",
    // This is broken because it tries to use EasyEffects.
    // "wireplumber#source",
    "wireplumber#sink", "backlight", "battery"],
  "sway/workspaces": {
    "all-outputs": true
  },
  "sway/window": {
    "format": "{title} – {app_id} {shell} [{marks}]",
    "rewrite" : {
      " –   \\[\\]": ""
    }
  },
  "custom/webcam": {
    "exec": "phone-webcam-icon",
    "on-click": "pkill -USR1 -f phone-webcam-icon"
  },
  "disk": {
    "format": "Disk ({path}) {percentage_used}%"
  },
  "memory": {
    "interval": 1,
    "format": "Mem {}%"
  },
  "cpu": {
    "interval": 1,
    "format": "CPU {usage:2}%"
  },
  "temperature": {
    "thermal-zone": 0,
    "hwmon-path": "/sys/class/thermal/thermal_zone0/temp",
    "format": "{temperatureC}°C"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰡀",
    "format-disconnected": "󰤮",
    "tooltip-format": "{ifname} {ipaddr}"
  },
  "backlight": {
    "format": "{percent}% 󰌵"
  },
  "battery": {
    "format-discharging": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰉁",
    "format-full": "{capacity}% {icon}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "wireplumber#sink": {
    "only-physical": true,
    "format": "{volume}% {icon}",
    "format-bluetooth": "󰂯{volume}% {icon}",
    "format-muted": "󰖁",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "format-icons": {
      "headphones": "󰋋",
      "headset": "󰋎",
      "phone": "󰥒",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle"
  },
  "wireplumber#source": {
    "only-physical": true,
    "node-type": "Audio/Source",
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle"
  },
  "clock": {
    "format": "{:%a, %b %d %H:%M %p}"
  }
}
